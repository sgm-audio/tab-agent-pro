# Tab Agent Pro — Environment Configuration
# Copy to .env if you need to override defaults: cp .env.example .env
# (.env is loaded by app.py, main.py, and run.sh; real environment variables take priority)

# Host binding (0.0.0.0 for Docker, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Server port for the web UI
PORT=7860

# Model cache directory (Basic Pitch ONNX model and any local checkpoints)
CACHE_DIR=~/.cache/tab_agent

# Compute device: auto, cpu, cuda, rocm, vulkan, mps, directml
#   auto   — detect the best available backend (NVIDIA CUDA, AMD ROCm,
#            AMD Vulkan, Apple MPS, Windows DirectML, else CPU)
#   cuda   — NVIDIA CUDA
#   rocm   — AMD ROCm (torch reports ROCm as CUDA via HIP)
#   vulkan — AMD/Intel/NVIDIA Vulkan (Basic Pitch via ONNX Vulkan EP)
#   mps    — Apple Silicon Metal
#   directml — Windows DirectML (Basic Pitch via ONNX DirectML EP)
#   cpu    — plain CPU (default, works everywhere)
#
# Falls back to CPU with a warning if the requested backend is unavailable.
DEVICE=auto

# Web UI concurrency. Each transcription is CPU/GPU-heavy (Demucs + Basic
# Pitch), so the queue is bounded: requests beyond the limit are rejected
# quickly instead of exhausting memory.
MAX_CONCURRENT_REQUESTS=1
QUEUE_MAX_SIZE=32

# Uploaded audio is pruned from the Gradio temp directory after this many
# seconds (default 15 minutes).
UPLOAD_TTL_SEC=900
