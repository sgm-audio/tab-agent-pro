# Tab Agent Pro — Environment Configuration
# Copy to .env if you need to override defaults: cp .env.example .env

# Host binding (0.0.0.0 for Docker, 127.0.0.1 for local)
HOST=127.0.0.1

# Server port
PORT=7860

# Model cache directory
CACHE_DIR=~/.cache/tab_agent

# HuggingFace Hub token (optional, for private/gated models)
# HF_TOKEN=

# PyTorch device (auto, cpu, cuda, mps)
DEVICE=auto
