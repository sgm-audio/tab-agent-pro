# Tab Agent Pro — Environment Configuration
# Copy to .env if you need to override defaults: cp .env.example .env
# (.env is loaded by app.py on startup; real environment variables take priority)

# Host binding (0.0.0.0 for Docker/Hugging Face Spaces, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Server port (Hugging Face Spaces expects 7860)
PORT=7860

# Model cache directory (used for the YourMT3+ checkpoint/codebase)
CACHE_DIR=~/.cache/tab_agent

# HuggingFace Hub token (optional, for private/gated models)
# HF_TOKEN=

# PyTorch device: auto, cpu, cuda, mps
DEVICE=auto

# Web UI concurrency. Each transcription is CPU-heavy (Demucs + Basic Pitch),
# so the queue is bounded: requests beyond the limit are rejected quickly
# instead of exhausting memory.
MAX_CONCURRENT_REQUESTS=1
QUEUE_MAX_SIZE=32

# Uploaded audio is pruned from the Gradio temp directory after this many
# seconds (default 15 minutes).
UPLOAD_TTL_SEC=900

# YourMT3+ checkpoint revision (commit sha). Empty = "main" with a warning.
# Set this to a reviewed sha in production: the checkpoint is loaded with
# torch.load, so its provenance is part of the supply chain.
# YOURMT3_REVISION=

# Set to 1 to make an unpinned YourMT3+ download a hard error (fail closed).
# Recommended in production; leave unset for local experimentation.
# YOURMT3_REQUIRE_PINNED_REVISION=1

# Set automatically by Hugging Face on ZeroGPU Spaces; do not set by hand.
# Acceleration is only advertised when this is "1".
# SPACES_ZERO_GPU=
